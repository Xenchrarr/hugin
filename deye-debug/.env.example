# SolarMan developer app credentials
# Obtain App ID and App Secret from https://home.solarmanpv.com/developer
DEYE_APP_ID=
DEYE_APP_SECRET=

# SolarMan account credentials (the ones you use to log in to the SolarMan app)
DEYE_EMAIL=
DEYE_PASSWORD=

# Logger device serial number — visible in the SolarMan app under your device info
DEYE_DEVICE_SN=
