# ── Energy Postgres ──
ENERGY_DB=energy
ENERGY_DB_USER=energy
ENERGY_DB_PASSWORD=          # REQUIRED — set a strong password

# ── Orchestrator Postgres ──
JOB_DB_USER_NAME=
JOB_DB_PASSWORD=
JOB_DB=orchestrator

# ── Nikolaipowerbot (EcoFlow MQTT) ──
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=

# ── Hugin Core ──
CAMERA_IP=
TIBBER_ACCESS_TOKEN=
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
SIMPLENOTE_EMAIL=
SIMPLENOTE_PASSWORD=
SIMPLENOTE_SHOPPING_LIST_KEY=
SIMPLENOTE_IDEAS_KEY=
PRIMARY_USER_ID=1           # Orchestrator user ID whose config holds Growatt credentials

# ── Google Calendar ──
GOOGLE_CALENDAR_ICAL_URLS=     # Comma-separated secret iCal URLs from each calendar's settings → "Secret address in iCal format"

# ── Telegram Bot ──
TELEGRAM_API_KEY=
NIKOLAI_TELEGRAM_ID=         # Telegram user ID for the nikolai_weather command
ALLOWED_USER_IDS=              # Comma-separated Telegram user IDs (empty = allow all)

# ── Telegram Relay ──
TELEGRAM_API_ID=               # Telegram app api_id (from my.telegram.org)
TELEGRAM_API_HASH=             # Telegram app api_hash (from my.telegram.org)
TELEGRAM_PHONE_NUMBER=         # Phone number linked to the Telegram account (+47xxxxxxxxx)
DB_ENCRYPTION_KEY=             # TDLib database encryption key (any strong passphrase)
MESSAGE_RELAY_ENDPOINT_KEY=telegram-main  # Source endpoint represented by this connector process

# ── Reticulum / LXMF ──
# Hugin renders the RNS config from these values on every container start.
RETICULUM_DISPLAY_NAME=Hugin
RETICULUM_NODE_NAME=Hugin Node
RETICULUM_ENABLE_TRANSPORT=true
RETICULUM_SHARE_INSTANCE=true
RETICULUM_PANIC_ON_INTERFACE_ERROR=false
RETICULUM_RNODE_ENABLED=true
RETICULUM_RNODE_DEVICE=/dev/ttyACM0       # Host device passed into the container
RETICULUM_RNODE_GID=18                    # Host dialout GID: getent group dialout
RETICULUM_RNODE_FREQUENCY=868000000
RETICULUM_RNODE_BANDWIDTH=125000
RETICULUM_RNODE_TXPOWER=14
RETICULUM_RNODE_SPREADING_FACTOR=7
RETICULUM_RNODE_CODING_RATE=5
RETICULUM_TCP_SERVER_ENABLED=true
RETICULUM_TCP_LISTEN_IP=0.0.0.0
RETICULUM_TCP_LISTEN_PORT=4242
RETICULUM_PROPAGATION_ENABLED=true
RETICULUM_MESSAGE_STORAGE_MB=512
RETICULUM_INBOUND_STAMP_COST=0
RETICULUM_ANNOUNCE_INTERVAL_SECONDS=21600
RETICULUM_CONFIG_REFRESH_SECONDS=30
RETICULUM_PATH_TIMEOUT_SECONDS=15
# Required only for endpoints using the "propagated" outbound delivery method.
RETICULUM_OUTBOUND_PROPAGATION_NODE=

# ── Messenger Relay PoC ──
# The access token belongs to the private Matrix user that logs into
# mautrix-meta. See messenger_relay/README.md; never commit the token.
MESSENGER_CONFIG_ROOT=/srv/hugin/messenger
MATRIX_USER_ID=@hugin:hugin.local
MATRIX_ACCESS_TOKEN=
MATRIX_BRIDGE_BOT_USER_ID=@facebookbot:hugin.local
MATRIX_GHOST_PREFIX=@facebook_
MESSENGER_CONFIG_REFRESH_SECONDS=30

# ── SMS Bot ──
# SMS senders are registered by phone number in the orchestrator users table.

# MMS support — used for Telegram photos in either direction
# HappyBytes/Telenor: MMS_MMSC_URL=http://mms.media  MMS_APN=mms
# Telia:              MMS_MMSC_URL=http://mmsc.telia.no/  MMS_APN=mms
MMS_MMSC_URL=                  # Carrier MMSC URL
MMS_APN=mms                    # APN for MMS bearer
MMS_CONTEXT_ID=3               # PDP context slot for MMS (default 3)
MMS_FROM_NUMBER=               # SIM's own phone number e.g. +4747XXXXXX (required if AT+CNUM is unsupported by modem)
MMS_PROXY_HOST=                # Carrier MMS proxy, if required for retrieval
MMS_PROXY_PORT=                # Carrier MMS proxy port
MMS_RECEIVE_MAX_BYTES=5242880  # Reject larger inbound MMS payloads (default 5 MB)
MMS_UPLOAD_MAX_BYTES=5242880   # Reject larger queued MMS uploads at sms-hub
SMS_DELIVERY_STALE_SECONDS=600 # In-flight receipt becomes uncertain after this timeout
SMS_DELIVERY_RECEIPT_RETENTION_DAYS=30

# ── Orchestrator ──
JOB_SCHEDULER_RUNNING=True
JOB_WORKER_THREADS=20
WORKFLOW_WORKER_THREADS=4
WORKFLOW_HEARTBEAT_SECONDS=30
JOB_ONCE_GRACE_SECONDS=300
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
MONITOR_WORKER_THREADS=4
MONITOR_POLL_LEASE_SECONDS=300
MONITOR_DISPATCH_INTERVAL_SECONDS=15
MONITOR_DISPATCH_LEASE_SECONDS=300
SERVICE_KEY=                   # REQUIRED shared secret for internal APIs
LOG_BATCH_SIZE=50              # PowerShell runner log entries per request
LOG_FLUSH_INTERVAL=2           # Maximum batching delay in seconds
TEAMS_WEBHOOK_URL=
GIT_USERNAME=
GIT_PASSWORD=
GIT_BRANCH=main
GIT_REPO_URLS=

# Message Hub delivery, health monitoring, and retention
MESSAGE_HUB_POLL_SECONDS=1
MESSAGE_HUB_HEALTH_INTERVAL_SECONDS=30
MESSAGE_HUB_DOWN_FAILURE_THRESHOLD=3
MESSAGE_HUB_UP_SUCCESS_THRESHOLD=2
MESSAGE_HUB_DEFAULT_TTL_SECONDS=2592000
MESSAGE_HUB_RETENTION_DAYS=30
MESSAGE_HUB_MAX_ATTACHMENT_BYTES=5242880  # Maximum binary attachment stored by Message Hub
# JSON array, for example:
# [{"gateway_key":"telegram-main","address":{"chat_id":123456789}}]
MESSAGE_HUB_ALERT_TARGETS=

PRINTER_DEVICE=
PRINTER_HUB_URL=http://printer-hub:6002
