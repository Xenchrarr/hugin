# ── Energy Postgres ──
ENERGY_DB=energy
ENERGY_DB_USER=energy
ENERGY_DB_PASSWORD=          # REQUIRED — set a strong password

# ── Orchestrator Postgres ──
JOB_DB_USER_NAME=
JOB_DB_PASSWORD=
JOB_DB=orchestrator

# ── Nikolaipowerbot (EcoFlow MQTT) ──
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=

# ── Hugin Core ──
CAMERA_IP=
TIBBER_ACCESS_TOKEN=
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
SIMPLENOTE_EMAIL=
SIMPLENOTE_PASSWORD=
SIMPLENOTE_SHOPPING_LIST_KEY=
PRIMARY_USER_ID=1           # Orchestrator user ID whose config holds Growatt credentials

# ── Telegram Bot ──
TELEGRAM_API_KEY=
NIKOLAI_TELEGRAM_ID=         # Telegram user ID for the nikolai_weather command
ALLOWED_USER_IDS=              # Comma-separated Telegram user IDs (empty = allow all)

# ── Telegram Relay ──
TELEGRAM_API_ID=               # Telegram app api_id (from my.telegram.org)
TELEGRAM_API_HASH=             # Telegram app api_hash (from my.telegram.org)
TELEGRAM_PHONE_NUMBER=         # Phone number linked to the Telegram account (+47xxxxxxxxx)
DB_ENCRYPTION_KEY=             # TDLib database encryption key (any strong passphrase)

# ── SMS Bot ──
ALLOWED_SENDERS=+47xxxxxxxx
SENDER_PINS=1234

# MMS support — required only if receiving Telegram photos via SMS
# HappyBytes/Telenor: MMS_MMSC_URL=http://mms.media  MMS_APN=mms
# Telia:              MMS_MMSC_URL=http://mmsc.telia.no/  MMS_APN=mms
MMS_MMSC_URL=                  # Carrier MMSC URL
MMS_APN=mms                    # APN for MMS bearer
MMS_CONTEXT_ID=3               # PDP context slot for MMS (default 3)

# ── Orchestrator ──
JOB_SCHEDULER_RUNNING=True
SERVICE_KEY=                   # Shared secret for service-to-service auth (hugin-core → orchestrator)
TEAMS_WEBHOOK_URL=
GIT_USERNAME=
GIT_PASSWORD=
GIT_BRANCH=main
GIT_REPO_URLS=
