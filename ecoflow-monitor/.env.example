# EcoFlow API credentials
ECOFLOW_ACCESS_KEY=your_access_key
ECOFLOW_SECRET_KEY=your_secret_key
ECOFLOW_BASE_URL=https://api-e.ecoflow.com

# Postgres
POSTGRES_DB=energy
POSTGRES_USER=energy
POSTGRES_PASSWORD=change_me_in_production

# Timezone for daily aggregation
TIMEZONE=Europe/Oslo

# Aggregator runs every N minutes (default 15)
AGGREGATOR_INTERVAL_MINUTES=15
